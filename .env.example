# Copy to .env.local (gitignored) and adjust.
# .env.local is read by scripts/run_stack.py and can be sourced by each service.
#
# The database is Supabase (or another hosted PostgreSQL). The local compose only
# starts Redis; it does not start PostgreSQL.

# --- PostgreSQL (Supabase) ---
# Preferred: the full JDBC URL with the pooler host and sslmode=require.
DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DB_HOST=HOST
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=require

DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
LIQUIBASE_ENABLED=true

# --- Redis (auth and any future cache users) ---
# docker compose -f infra/docker-compose.yml up -d
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- Auth ---
# Use a random value of at least 32 characters outside development.
JWT_SECRET=distrimarket-dev-secret-cambiar-en-produccion-2026
JWT_ISSUER=distrimarket-auth
JWT_EXPIRATION=60m
AUTH_BOOTSTRAP_ADMIN=true
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=Admin123!
